<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#10100f" />
    <title>zosc. — Motion 02</title>
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('pending');
      window.setTimeout(() => document.documentElement.classList.remove('pending'), 4000);
    </script>
    <style>
      @font-face { font-family: Montserrat; src: url('/fonts/montserrat-latin.woff2') format('woff2'); font-weight: 100 900; font-display: block; }
      :root { color-scheme: dark; --paper: #efeee8; --orange: #ff5934; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #10100f; color: var(--paper); font-family: Montserrat, sans-serif; -webkit-font-smoothing: antialiased; }
      main { min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; padding: clamp(24px, 4vw, 64px); overflow: hidden; }
      header, footer { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
      header { font-size: 10px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #82827b; }
      .edition { color: var(--paper); }
      .edition::before { content: ''; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--orange); margin-right: 10px; vertical-align: 2px; }
      .stage { position: relative; display: flex; align-items: center; justify-content: center; min-height: 300px; }
      h1 { display: flex; align-items: baseline; margin: -.07em 0 0 -.035em; font-size: clamp(100px, 26vw, 360px); font-weight: 900; line-height: 1.2; letter-spacing: -.045em; }
      .cell { display: inline-block; }
      .glyph { display: inline-block; transform-origin: 50% 72%; }
      .stop { flex: none; display: block; width: .145em; height: .145em; border-radius: 50%; background: var(--orange); margin-left: .07em; align-self: baseline; }
      .seed { position: absolute; width: clamp(22px, 3.5vw, 52px); aspect-ratio: 1; border-radius: 50%; background: var(--orange); opacity: 0; pointer-events: none; }
      .pending .glyph, .pending .stop { opacity: 0; }
      footer { font-size: 10px; color: #82827b; letter-spacing: .08em; min-height: 48px; }
      .signature { display: flex; align-items: center; gap: 13px; }
      .signature::before { content: ''; width: 24px; height: 1px; background: #55554f; }
      button { font: inherit; letter-spacing: inherit; color: var(--paper); background: transparent; border: 1px solid #3c3c36; border-radius: 100px; padding: 14px 20px; min-height: 46px; cursor: pointer; transition: border-color .2s, background-color .2s; }
      button:hover { background: #24241f; border-color: #77776c; }
      button:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }
      button span { pointer-events: none; margin-left: 12px; }
      @media (max-width: 600px) {
        main { padding: 24px; }
        h1 { font-size: 30vw; }
        header { font-size: 9px; }
        .signature { font-size: 9px; }
      }
      @media (prefers-reduced-motion: reduce) { #replay { visibility: hidden; } }
    </style>
  </head>
  <body>
    <main>
      <header><span class="edition">zosc / 02</span><span>In good motion.</span></header>
      <section class="stage" aria-label="ZOSC animated wordmark">
        <h1 aria-label="zosc.">
          <span class="cell" aria-hidden="true"><span class="glyph">z</span></span><span class="cell" aria-hidden="true"><span class="glyph">o</span></span><span class="cell" aria-hidden="true"><span class="glyph">s</span></span><span class="cell" aria-hidden="true"><span class="glyph">c</span></span><span class="stop" aria-hidden="true"></span>
        </h1>
        <span class="seed" aria-hidden="true"></span>
      </section>
      <footer><span class="signature">An independent mind.</span><button id="replay" type="button" aria-label="Replay animation">Replay<span aria-hidden="true">↻</span></button></footer>
    </main>
    <script>
      import gsap from 'gsap';

      // This preview deliberately has no shared layout or ClientRouter.
      const letters = Array.from(document.querySelectorAll<HTMLElement>('.glyph'));
      const word = document.querySelector<HTMLElement>('h1')!;
      const seed = document.querySelector<HTMLElement>('.seed')!;
      const stop = document.querySelector<HTMLElement>('.stop')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      let timeline: gsap.core.Timeline | undefined;

      function finish() {
        timeline?.kill();
        gsap.set([...letters, word, stop, seed], { clearProps: 'all' });
        document.documentElement.classList.remove('pending');
        document.body.dataset.motion = 'complete';
      }

      function play() {
        finish();
        if (reduce.matches) return;
        const center = word.getBoundingClientRect();
        const seedBox = seed.getBoundingClientRect();
        const stopBox = stop.getBoundingClientRect();
        const originX = seedBox.left + seedBox.width / 2;
        const originY = seedBox.top + seedBox.height / 2;
        const letterCenters = letters.map(letter => {
          const r = letter.getBoundingClientRect();
          return originX - (r.left + r.width / 2);
        });
        const dotX = stopBox.left + stopBox.width / 2 - originX;
        const dotY = stopBox.top + stopBox.height / 2 - originY;
        document.body.dataset.motion = 'playing';
        gsap.set(letters, { opacity: 0, x: i => letterCenters[i], y: center.height * .07, scaleX: .25, scaleY: .8 });
        gsap.set(stop, { opacity: 0 });
        gsap.set(seed, { opacity: 1, scale: 0 });
        timeline = gsap.timeline({ onComplete: finish });
        timeline
          .to(seed, { scale: 1, duration: .45, ease: 'back.out(2.2)' }, .12)
          .to(seed, { scaleX: .7, scaleY: 1.3, duration: .18, ease: 'power2.in' }, .6)
          .to(letters[1], { opacity: 1, x: 0, y: 0, scaleX: 1, scaleY: 1, duration: .8, ease: 'power4.out' }, .8)
          .to(letters[0], { opacity: 1, x: 0, y: 0, scaleX: 1, scaleY: 1, duration: .85, ease: 'power4.out' }, .91)
          .to(letters[2], { opacity: 1, x: 0, y: 0, scaleX: 1, scaleY: 1, duration: .9, ease: 'power4.out' }, .96)
          .to(letters[3], { opacity: 1, x: 0, y: 0, scaleX: 1, scaleY: 1, duration: .95, ease: 'power4.out' }, 1.03)
          .to(seed, { x: dotX * .66, y: -center.height * .4, scaleX: .9, scaleY: .9, duration: .48, ease: 'power2.out' }, .8)
          .to(seed, { x: dotX, y: dotY, scale: stopBox.width / seedBox.width, duration: .42, ease: 'power2.in' }, 1.28)
          .set(seed, { opacity: 0 }, 1.7)
          .set(stop, { opacity: 1, transformOrigin: '50% 100%' }, 1.7)
          .to(stop, { scaleX: 1.2, scaleY: .65, duration: .1, ease: 'power2.out' }, 1.7)
          .to(stop, { scaleX: 1, scaleY: 1, duration: .48, ease: 'elastic.out(1, .4)' }, 1.8)
          .to(word, { scale: 1.016, duration: .12, ease: 'power2.out' }, 1.73)
          .to(word, { scale: 1, duration: .5, ease: 'power3.out' }, 1.85);
      }

      const replay = () => { try { play(); } catch (error) { finish(); console.error(error); } };
      document.getElementById('replay')!.addEventListener('click', replay);
      reduce.addEventListener('change', finish);
      window.addEventListener('resize', finish);
      document.addEventListener('visibilitychange', () => { if (document.hidden) finish(); });
      // Measure only once the self-hosted display face is ready.
      document.fonts.ready.then(replay).catch(finish);
    </script>
  </body>
</html>
